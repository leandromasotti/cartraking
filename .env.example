# ---------------------------------------------------------------------------
# Google Sheets: origen de datos de los servicios
# ---------------------------------------------------------------------------
# API key con acceso de solo lectura a la Sheets API v4.
# IMPORTANTE: restringila en la consola de Google a la Sheets API y, si el
# deploy tiene IP fija, tambien por IP. Nunca la commitees.
# https://console.cloud.google.com/apis/credentials
GOOGLE_SHEETS_API_KEY=

# ID de la planilla (el tramo entre /d/ y /edit en la URL de Google Sheets)
GOOGLE_SHEET_ID=1zys7fdduzD5hoT8qpfBAUqWU2E2hx1NXcf-gLlWzCBU

# Hoja y rango de columnas a leer (A..J)
GOOGLE_SHEET_RANGE=Respuestas de formulario 5!A:J

# Segundos que se cachea la planilla en memoria antes de volver a pedirla
SHEET_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# URL publica del sitio. Es la base de los links que codifica el QR impreso.
# En Vercel podes dejarla vacia: se deduce de VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://doloreslubricantes.vercel.app
